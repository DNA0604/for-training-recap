function halamanPenyiapanEvaluasi_(){return '<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'+gayaHalamanAkses_()+'</head><body><main class="proof"><h1>Spreadsheet Penilaian Peserta</h1><p>File terpisah untuk penugasan Pengajar dan enam aspek evaluasi peserta per sesi. Nilai perilaku/JP lama tetap digunakan dari sumber semula.</p><p id="status" role="status">Memuat…</p><form id="setup"><label for="book">ID/tautan file penilaian (kosongkan untuk membuat file baru)</label><input id="book"><p><label><input id="confirm" type="checkbox" required style="width:auto;min-height:0"> Saya memilih file khusus penilaian, terpisah dari file utama dan akses.</label></p><button id="save" class="primary">Siapkan File Penilaian</button></form><a id="link" target="_blank" rel="noopener noreferrer" hidden>Buka Spreadsheet Penilaian</a></main><script>const $=id=>document.getElementById(id);function rpc(n,d){return new Promise((a,b)=>google.script.run.withSuccessHandler(a).withFailureHandler(b)[n](d));}async function load(){try{const r=await rpc("muatPenyiapanEvaluasi");if(r.konfigurasi){$("book").value=r.konfigurasi.id;$("book").readOnly=true;$("status").textContent="Status: "+r.konfigurasi.status;$("link").href=r.konfigurasi.url;$("link").hidden=false;}else $("status").textContent="Belum ada file penilaian yang dihubungkan.";}catch(e){$("status").textContent=e.message;}}$("setup").addEventListener("submit",async e=>{e.preventDefault();$("save").disabled=true;try{const r=await rpc("siapkanSpreadsheetEvaluasi",{spreadsheet:$("book").value,konfirmasi:$("confirm").checked});$("status").textContent=r.pesan;await load();}catch(e){$("status").textContent=e.message;}finally{$("save").disabled=false;}});load();</script></body></html>';}
function skripEvaluasiPengajar_(){return String.raw`
